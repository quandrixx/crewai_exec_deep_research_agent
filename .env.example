# Copy to .env and fill in. .env is gitignored.

# Required. Every agent in the pipeline uses it.
ANTHROPIC_API_KEY=

# Recommended. Powers external web research via https://serper.dev (free tier
# is plenty for a demo run). Without it the pipeline still completes using the
# internal knowledge base alone, and warns you that external research was
# unavailable rather than silently producing a thinner report.
SERPER_API_KEY=

# Optional. Override where the mock corpus and house-style references are read
# from - the seam a real deployment would use to point at a mounted store.
# KNOWLEDGE_DIR=
# INTERNAL_DOCS_DIR=
