{
  // External half of the research stage. Single agent, single task.
  //
  // Why this is its own crew rather than a second task alongside the internal
  // researcher: CrewAI's Crew validator (validate_end_with_at_most_one_async_task)
  // rejects a crew ending in more than one async task, and pairing an async task
  // with a following sync one doesn't help either - _run_sequential_process
  // drains pending futures BEFORE starting the sync task, so the two serialize.
  // Two independent tasks genuinely cannot run concurrently inside one crew.
  //
  // The parallelism matters enough to justify the split. These two halves must
  // be gathered without either seeing the other, or the final report's "Where
  // Sources Disagree" section measures contamination rather than real
  // disagreement - and running them back-to-back roughly doubles the stage's
  // wall time for no benefit. research_crew.py kicks both crews off together.
  "name": "external_research_crew",

  "agents": ["web_researcher"],

  "tasks": [
    {
      "name": "external_research_task",
      "agent": "web_researcher",

      "description": "Research what public sources say about {topic}, for an investment committee at Northbridge Ventures deciding whether to source deals in this sector.\n\nRun 4-6 SEPARATE, NARROW searches rather than one broad one. The search tool returns markedly better results for 'enhanced geothermal drilling cost per well 2026' than for the bare sector name. Cover these angles, adapting the wording to {topic}:\n  1. Recent funding rounds, investors, and valuations in the sector\n  2. Named companies - both established players and startups founded recently\n  3. Regulatory, permitting, or policy changes in the last 12-24 months\n  4. Technical or cost milestones that changed what is commercially viable\n  5. Announced commercial deployments, offtake agreements, or customer contracts\n  6. Credible skepticism - delays, cancellations, or analysts arguing the sector is overhyped\n\nThat last angle is not optional. A briefing that only surfaces good news is one a partner cannot trust.\n\nTurn what you find into atomic claims. One claim states one fact. 'Company A raised $42M in March 2026' and 'Company A uses a molten salt design' are two claims, not one. Prefer claims carrying a specific company name, dollar amount, date, or measurement - vague claims cannot be turned into the funding tables and company profiles this report needs.\n\nRules that are not negotiable:\n  - Every claim cites the exact URL the search tool returned as its source. Never cite a publication name alone, never construct a plausible-looking URL.\n  - Set source_type to 'external' on every claim.\n  - If a search returns an error message rather than results, that search failed. Report what you did find from other searches and do not invent findings to fill the gap.\n  - Set confidence honestly: around 0.9 for a specific figure stated directly by a primary or reputable source, around 0.6 when reported second-hand or approximated, around 0.4 when the source hedges or the detail is contested.\n\nReturning 8-15 well-sourced claims is a good outcome. Returning 25 where several are padding is a bad one.",

      "expected_output": "A ClaimList: a JSON object with a single 'claims' key holding a list of claim objects. Each has 'claim' (one factual statement), 'source' (the exact URL returned by the search tool), 'source_type' (always 'external'), and 'confidence' (0 to 1).",

      "output_pydantic": { "python": "external_refs.ClaimList" },

      // Deterministic check: real URLs, correct source_type, no empty claims.
      // Plain Python, not an LLM reviewing another LLM.
      "guardrail": { "python": "external_refs.validate_external_claims" },
      "guardrail_max_retries": 2
    }
  ],

  "process": "sequential",
  "verbose": true,

  // Off deliberately. Memory would carry claims between runs on different
  // topics, which is exactly how a fact about one sector ends up cited in
  // another sector's briefing. Every run researches its topic from scratch.
  "memory": false,

  // Default kickoff input; overridden per run by ResearchCrew.run(topic).
  "inputs": {
    "topic": "small modular reactors"
  }
}
